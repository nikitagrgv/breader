    <string name="line_spacing_summary">More space between lines makes them easier to tell apart, especially with dyslexia or low vision.</string>
    <string name="margins">Margins</string>
    <string name="margins_value">%1$d dp</string>
    <string name="margins_summary">Space at the sides of the text. On wide screens, there\'s more of it: lines longer than about 70 characters are hard to follow.</string>
    <string name="justify">Justify text</string>
    <string name="justify_summary">Stretch the spaces so that lines end evenly at the right edge. Android shows the selection shifted on such lines, the more the further right.</string>
    <string name="hyphenation">Hyphenation</string>
    <string name="hyphenation_summary">Split long words at the end of a line. When off, lines break between whole words.</string>
    <string name="text_preview">Justification stretches the spaces between words, so that every line ends at the right edge, and hyphenation splits extraordinarily long words to keep those spaces small.</string>

